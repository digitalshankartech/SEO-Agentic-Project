{
  "name": "seo-agentic-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"corepack pnpm --filter @seo/api dev\" \"corepack pnpm --filter @seo/web dev\"",
    "start:local": "concurrently \"corepack pnpm --filter @seo/api dev\" \"corepack pnpm --filter @seo/web dev\"",
    "build": "corepack pnpm --filter @seo/api build && corepack pnpm --filter @seo/web build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.0",
    "prettier": "^3.8.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
